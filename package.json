{
  "name": "fontshelf",
  "version": "0.1.0",
  "description": "One font service for browser editors: installed-font detection, a curated Google Fonts catalog behind a single consent, plain TTF/OTF bytes for engines that embed fonts, embedding-permission checks and a shared picker.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-wasm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "prepare": "tsc -p tsconfig.json && node scripts/copy-wasm.mjs"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "harfbuzzjs": "1.6.4",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  }
}
